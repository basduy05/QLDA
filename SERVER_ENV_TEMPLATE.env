# Server Deployment Environment Template
# Copy this to your server as .env in the project root

# ============================================
# Server Configuration
# ============================================
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=mysql://root:password@localhost:3306/qhorizonpm_db
DB_HOST=localhost
DB_PORT=3306
DB_NAME=qhorizonpm_db
DB_USER=root
DB_PASSWORD=your_password_here

# ============================================
# JWT & Security
# ============================================
JWT_SECRET=your_super_secret_key_here_change_this
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d

# ============================================
# CORS & Origins
# ============================================
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173,https://your-domain.com

# ============================================
# Email Configuration (Brevo)
# ============================================
MAIL_FROM=noreply@your-domain.com
MAIL_FROM_NAME=APERLEX
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@your-domain.com
BREVO_SENDER_NAME=APERLEX

# ============================================
# AWS S3 (Optional - for file uploads)
# ============================================
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
AWS_S3_URL=https://your-bucket-name.s3.amazonaws.com

# ============================================
# Google Gemini (Optional - for AI features)
# ============================================
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# Redis (Optional - for caching/sessions)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# WebRTC Configuration
# ============================================
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302
WEBRTC_TURN_SERVER=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_PASSWORD=

# ============================================
# Environment Specific
# ============================================
DEBUG=aperlex:*
APP_NAME=APERLEX
APP_URL=https://your-domain.com
